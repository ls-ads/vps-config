{% set ops_domain = item.0 %}
{% set tool = item.1 %}
{% set fqdn = tool.name ~ '.' ~ ops_subdomain ~ '.' ~ env_prefix ~ ops_domain.name %}
{% set cert_primary = domain_cert_primary[ops_domain.name] %}
# {{ tool.name | capitalize }} on {{ ops_domain.name }} — Tailscale-only; DNS points at {{ tailscale_ip }}.
# Security note: routing here is by Host header; origin_lockdown (Prod) +
# no public DNS record (both envs) keep this off the open internet.

server {
    listen 80;
    server_name {{ fqdn }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name {{ fqdn }};

    ssl_certificate     /etc/letsencrypt/live/{{ cert_primary }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ cert_primary }}/privkey.pem;

    resolver 127.0.0.11 valid=30s;
    set $upstream http://{{ tool.name }}:{{ tool.port }};

    location / {
        limit_req zone=ops burst=60 nodelay;
        proxy_pass $upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
