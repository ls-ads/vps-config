# Managed by Ansible (roles/nginx). Do not edit — regenerated every run
# from secrets.yml + group_vars.

POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}

# Grafana takes one canonical URL — use the first domain. Other domains'
# /grafana endpoints still work (nginx routes by Host header), they just
# won't appear in Grafana-generated URLs (email links, OAuth callbacks).
{% set primary_ops_domain = domains | first %}
GF_SERVER_ROOT_URL=https://grafana.{{ ops_subdomain }}.{{ env_prefix }}{{ primary_ops_domain.name }}
GF_SERVER_DOMAIN=grafana.{{ ops_subdomain }}.{{ env_prefix }}{{ primary_ops_domain.name }}

# SMTP for Grafana alert mailer (SendGrid).
#   - Reuses `sendgrid_api_key` secret unless an alerts-specific
#     `grafana_smtp_password` is set in secrets.yml.
#   - From-address falls back to `alerts@<primary-domain>` if not
#     overridden via `grafana_smtp_from_address`. Make sure the
#     domain has SendGrid sender authentication configured (DNS
#     records) so the mail isn't dropped or marked spam.
#   - Set `grafana_smtp_enabled: false` in group_vars to disable
#     entirely (alerts will fire but only show in the UI).
GF_SMTP_ENABLED={{ (grafana_smtp_enabled | default(true)) | string | lower }}
GF_SMTP_PASSWORD={{ grafana_smtp_password | default(sendgrid_api_key) }}
GF_SMTP_FROM_ADDRESS={{ grafana_smtp_from_address | default('alerts@' ~ primary_ops_domain.name) }}
GF_SMTP_FROM_NAME={{ grafana_smtp_from_name | default('Grafana Alerts') }}
{% if ngrok_enabled | default(false) %}
NGROK_AUTHTOKEN={{ ngrok_authtoken }}
{% endif %}
