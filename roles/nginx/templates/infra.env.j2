# Managed by Ansible (roles/nginx). Do not edit — regenerated every run
# from secrets.yml + group_vars.

POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}

# For Grafana's root-url / domain settings. Ops endpoints are always on
# the parent apex, so we use the parent-zone cert domain here.
GF_SERVER_ROOT_URL=https://grafana.{{ ops_subdomain }}.{{ env_prefix }}{{ apex_domain }}
GF_SERVER_DOMAIN=grafana.{{ ops_subdomain }}.{{ env_prefix }}{{ apex_domain }}
