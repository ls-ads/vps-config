# Managed by Ansible (roles/apps). Do not edit — regenerated from
# group_vars + secrets.yml on every deploy.

{% if app.needs_database | default(false) %}
DATABASE_URL=postgresql://{{ app.name }}:{{ lookup('vars', app.name + '_db_password') }}@postgres:5432/{{ app.name }}
{% endif %}
{% if app.db_pool_min_size is defined %}
DB_POOL_MIN_SIZE={{ app.db_pool_min_size }}
{% endif %}
{% if app.db_pool_max_size is defined %}
DB_POOL_MAX_SIZE={{ app.db_pool_max_size }}
{% endif %}
{% if app.needs_jwt | default(false) %}
JWT_SECRET={{ lookup('vars', app.name + '_jwt_secret') }}
{% endif %}
{% for k, v in (app.env | default({})).items() %}
{{ k }}={{ v }}
{% endfor %}
