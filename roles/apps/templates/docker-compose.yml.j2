# Managed by Ansible (roles/apps). Do not edit — regenerated from
# group_vars/all.yml + secrets.yml on every deploy.
#
# When `app.replicas` > 1 the role renders N services named
# `<app>-1`, `<app>-2`, … all sharing the same image + .env. The
# matching nginx vhost includes an `upstream` block that round-robins
# across them. Use to scale single-threaded SSR or workers
# horizontally on a single VM (Postgres + Redis are still single
# instances; size their connection pools accordingly).
#
# Each replica also registers the bare app name (`<app>`) as a docker
# network alias. Other containers on the same network can keep using
# `http://<app>:<port>` and Docker's embedded DNS round-robins
# across the replica IPs. Without this, code that hard-coded the old
# single-container hostname (e.g. SvelteKit → FastAPI proxy) would
# break with `fetch failed` after the first replica scale-up.

services:
{% set replicas = app.replicas | default(1) | int %}
{% set net = infra_network_name | default('infra') %}
{% for i in range(1, replicas + 1) %}
{%   set svc = app.name if replicas == 1 else (app.name ~ '-' ~ i) %}
  {{ svc }}:
    image: {{ app.image }}
    container_name: {{ svc }}
    restart: unless-stopped
    env_file:
      - .env
    networks:
{%   if replicas > 1 %}
      {{ net }}:
        aliases:
          - {{ app.name }}
{%   else %}
      - {{ net }}
{%   endif %}
{% endfor %}

networks:
  {{ net }}:
    external: true
    name: {{ net }}
