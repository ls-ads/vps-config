---
# Shared variables across both environments. Copy to group_vars/all.yml
# (gitignored) and fill in.

admin_email: you@example.com

# On-disk layout for /opt/server. Rarely overridden — every role
# references these paths so promoting them out of role defaults makes
# them available to single-role plays (deploy_app.yml).
server_root: /opt/server
server_infra_dir: "{{ server_root }}/infrastructure"
server_apps_dir: "{{ server_root }}/apps"

# Subdomain prefix for observability tools, applied uniformly under
# every domain you operate. e.g. with ops_subdomain=ops you get
# grafana.ops.example.com, grafana.ops.example.org, etc. — all served
# by the same Grafana container, just routed by Host header. The DNS
# records for these resolve to the VM's Tailscale IP, so anyone not
# on the tailnet can't reach them.
ops_subdomain: ops

# Every domain you operate. Each gets its own Cloudflare zone, its own
# cert lineage, and its own set of ops endpoints — no domain is treated
# as the "parent" of the others. Add as many as you want.
#
# Two API tokens per domain (more granular than one combined token):
#   dns_vault_key       — Zone:DNS:Edit, used by certbot DNS-01 challenge.
#   firewall_vault_key  — Zone:Firewall Services:Edit, used by fail2ban
#                         to push bans to IP Access Rules.
# Both keys name an entry in secrets.yml. Mint scoped tokens at
# https://dash.cloudflare.com/profile/api-tokens and restrict each to
# its single zone.
domains:
  - name: example.com
    zone_id: <32-hex-zone-id-for-example-com>
    dns_vault_key: cf_token_example_com_dns
    firewall_vault_key: cf_token_example_com_firewall
  - name: example.org
    zone_id: <32-hex-zone-id-for-example-org>
    dns_vault_key: cf_token_example_org_dns
    firewall_vault_key: cf_token_example_org_firewall

# Apps to deploy on every VM. Each name corresponds to apps/<name>/.
# `base_domain` must match one of the names in `domains` above (the
# apps role uses it to find the matching cert lineage). The playbooks
# render the per-env domain (env_prefix + base_domain, with optional
# subdomain prefix) at deploy time.
apps:
  - name: frontend
    base_domain: example.com    # → example.com (Prod) / uat.example.com (UAT)
    image: ghcr.io/<owner>/frontend:latest
    port: 3000
    needs_database: true
    needs_jwt: true
  - name: myapp
    base_domain: example.org    # → example.org (Prod) / uat.example.org (UAT)
    image: ghcr.io/<owner>/myapp:latest
    port: 3000
    needs_database: true
    needs_jwt: true
    # Per-app env vars (in addition to the auto-generated DATABASE_URL +
    # JWT_SECRET). Reference vault values via {{ ... }}.
    # env:
    #   ORIGIN: "https://{{ env_prefix }}example.org"
    #   BETTER_AUTH_SECRET: "{{ myapp_better_auth_secret }}"
  - name: myapp-api
    base_domain: example.org
    subdomain: api              # → api.example.org (Prod) / api.uat.example.org (UAT)
    image: ghcr.io/<owner>/myapp-api:latest
    port: 8000
    needs_database: false       # shares myapp's DB (set DATABASE_URL via env below)
    needs_jwt: false
    # env:
    #   DATABASE_URL: "postgresql://myapp:{{ myapp_db_password }}@postgres:5432/myapp"

# Optional: extra DNS records the cloudflare_dns role should maintain
# alongside the auto-derived set (apps, ops endpoints, ssh.<env>).
# Each entry is a dict; `proxied` is ignored for non-A/AAAA/CNAME types.
#
# Put env-agnostic records here — external MX hosts, verification TXTs,
# SPF/DKIM, etc. Records that reference `ansible_host` or `tailscale_ip`
# are env-specific (different value on each VM) and belong in
# group_vars/prod.yml or group_vars/uat.yml instead, otherwise whichever
# VM ran last will overwrite the others' record.
#
# dns_extra_records:
#   - domain: example.org
#     name: example.org
#     type: MX
#     content: "10 mail.elsewhere.net"
#     proxied: false
#   - domain: example.com
#     name: example.com
#     type: TXT
#     content: "v=spf1 include:_spf.elsewhere.net ~all"
#     proxied: false
