---
# Secrets template. Copy to secrets.yml (gitignored), fill in, and rsync
# / paste-via-CI to the deploy host. Each playbook references this via
# `vars_files: [../secrets.yml]`.
#
# Generate random values with:
#   openssl rand -base64 30 | tr -d '=+/' | cut -c1-32   (for passwords)
#   openssl rand -hex 32                                  (for JWT-shaped secrets)

# --- Infrastructure secrets ---
postgres_password: <random-32-chars>
grafana_admin_password: <random-32-chars>
deploy_user_password: <random-32-chars>     # consumed only on first provision

# --- GHCR (PAT with read:packages — server uses this to pull private images) ---
ghcr_user: <github-username>
ghcr_token: ghp_xxxxxxxxxxxxxxxxxxxx

# --- Cloudflare API tokens ---
# Two tokens per domain — one for DNS (used by certbot DNS-01), one for
# Firewall Services (used by fail2ban CF ban action). Keys must match
# the `dns_vault_key` / `firewall_vault_key` values in `domains`
# (group_vars/all.yml). Each token restricted to a single zone.
cf_token_example_com_dns: cfat_xxxxxxxxxxxxxxxxxxxx
cf_token_example_com_firewall: cfat_xxxxxxxxxxxxxxxxxxxx
cf_token_example_org_dns: cfat_xxxxxxxxxxxxxxxxxxxx
cf_token_example_org_firewall: cfat_xxxxxxxxxxxxxxxxxxxx

# --- Tailscale ---
# Auth key — mint a reusable, non-expiring key at:
#   https://login.tailscale.com/admin/settings/keys (Auth keys tab).
# Tag it with whatever role you use to gate ACLs (e.g. "tag:server").
tailscale_auth_key: tskey-auth-xxxxxxxxxxxxxxxxxxxx

# Optional API access token (different from the auth key — type:
# "API access" at the same URL above, separate tab). When set, the
# tailscale role deletes any tailnet device whose hostname matches
# before re-authenticating, so a rebuilt VM reclaims its canonical
# name (uat-vm) instead of being registered as uat-vm-1, uat-vm-2,
# etc. Leave empty to skip.
tailscale_api_key: ""

# --- Per-app secrets ---
# One entry per app declared in apps (group_vars/all.yml) whose
# `needs_database` / `needs_jwt` is true, named `<app>_db_password` and
# `<app>_jwt_secret`. Reference any custom env-var values here too.
#
# frontend_db_password: <random>
# frontend_jwt_secret: <random-hex>
# myapp_db_password: <random>
# myapp_jwt_secret: <random-hex>
